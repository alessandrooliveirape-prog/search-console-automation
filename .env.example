# === Google OAuth2 (Search Console + GA4 Data API) ===
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth2callback
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# === Google Gemini AI ===
GEMINI_API_KEY=your-gemini-api-key

# === Google Analytics 4 — Property IDs por site ===
# Formato: "properties/123456789" (encontre em GA4 > Admin > Propriedade > Detalhes)
GA4_PROPERTY_EMPREGAPE=properties/YOUR_GA4_PROPERTY_ID
GA4_PROPERTY_BRASILCALCULADORAS=properties/YOUR_GA4_PROPERTY_ID
GA4_PROPERTY_MESTREDAFEDERAL=properties/YOUR_GA4_PROPERTY_ID
GA4_PROPERTY_TOOLBRASIL=properties/YOUR_GA4_PROPERTY_ID

# === PageSpeed Insights API Key (opcional) ===
# Sem key: limite de 25 req/dia. Com key: 400 req/dia.
# Obtenha em: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
PAGESPEED_API_KEY=

# === Telegram Bot (opcional) ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# === CallMeBot WhatsApp (opcional) ===
CALLMEBOT_API_KEY=
